# ========================
# Root .gitignore
# ========================

# Node.js / Server
/node_modules
/dist
/build
.env
.env.local
.env.*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# TypeScript
*.tsbuildinfo

# Logs
logs
*.log
*.log.*
pids
*.pid
*.seed

# OS Files
.DS_Store
Thumbs.db

# ========================
# Client (React / Next.js)
# ========================

/client/node_modules
/client/.next
/client/out
/client/build
/client/.env
/client/.env.local
/client/.env.*.local
/client/npm-debug.log*
/client/yarn-debug.log*
/client/yarn-error.log*
/client/pnpm-debug.log*
/client/.vscode
/client/.idea

# ========================
# Server (Node/Express)
# ========================

/server/node_modules
/server/dist
/server/.env
/server/.vscode
/server/.idea

# Optional: VSCode workspace settings
/.vscode
/.idea

# Optional: OS specific
*.swp
images